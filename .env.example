# ─── Base de datos ───────────────────────────────────────────────
# Postgres (docker-compose). Para MVP rápido puedes usar sqlite.
DATABASE_URL=postgresql+asyncpg://atalaya:atalaya@db:5432/atalaya
# DATABASE_URL=sqlite+aiosqlite:///./atalaya.sqlite3

# ─── Capa IA ─────────────────────────────────────────────────────
# Proveedor de LLM para triaje y consulta en lenguaje natural.
# AI_PROVIDER selecciona la implementación de LLMProvider: "anthropic" (Claude)
# o "gemini" (Google AI Studio). Solo hace falta rellenar la clave del
# proveedor elegido; la del otro puede quedar vacía.
# Sin la clave del proveedor activo, POST /scans/{id}/triage y
# POST /findings/ask devuelven 502 (AIProviderError) al instanciarlo.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=1024
AI_TIMEOUT=60
AI_MAX_RETRIES=2
# Triajes concurrentes al procesar varios hallazgos de un escaneo.
AI_CONCURRENCY=5

# ─── Informes ─────────────────────────────────────────────────────
# Directorio donde se escriben los informes PDF generados (GET /scans/{id}/report).
REPORTS_DIR=reports

# ─── APIs externas (descubrimiento) ──────────────────────────────
# Opcionales: la herramienta funciona sin ellas, con menos cobertura.
# Segunda fuente de enumeración de subdominios (discovery/shodan.py), junto
# a crt.sh. Sin clave, se omite sin generar ninguna incidencia.
SHODAN_API_KEY=
SHODAN_URL=https://api.shodan.io
SHODAN_RETRIES=3
# crt.sh y OSV no requieren clave.

# Endpoint de Certificate Transparency y robustez de la consulta.
CRTSH_URL=https://crt.sh
HTTP_TIMEOUT=30
CRTSH_RETRIES=3

# ─── Resolución DNS ──────────────────────────────────────────────
DNS_TIMEOUT=3
DNS_CONCURRENCY=50
# Servidores DNS a usar (vacío = los del sistema). Ej: 1.1.1.1,8.8.8.8
DNS_RESOLVERS=

# ─── Descubrimiento: puertos ──────────────────────────────────────
PORT_SCAN_TIMEOUT=2
# Conexiones simultáneas dentro del escaneo de un único host.
PORT_SCAN_CONCURRENCY=100

# ─── Descubrimiento: cabeceras HTTP ───────────────────────────────
HEADER_SCAN_TIMEOUT=10

# ─── Descubrimiento: TLS ───────────────────────────────────────────
TLS_SCAN_TIMEOUT=5

# ─── Descubrimiento: verificación de takeover (opt-in) ────────────
# OFF por defecto. Con "true", además de detectar el patrón de CNAME, hace
# un GET a la página de error del proveedor de terceros para buscar su huella
# de "recurso no reclamado" (excepción acotada a la restricción de seguridad
# #6 — ver CLAUDE.md). Eleva el hallazgo a "alta sospecha", NUNCA a
# "confirmado"; solo actúa sobre hostnames en SCAN_ALLOWLIST y deja auditoría
# de cada petición a terceros.
TAKEOVER_VERIFY=false
TAKEOVER_VERIFY_TIMEOUT=10

# ─── Enriquecimiento (puertos + cabeceras + TLS) ──────────────────
# Hosts procesados en paralelo por cada técnica al enriquecer un escaneo.
ENRICHMENT_HOST_CONCURRENCY=10

# ─── Aplicación ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Límite de seguridad: solo se escanean dominios en esta lista (autorización).
# Separados por comas. Vacío = sin restricción (usar con responsabilidad).
SCAN_ALLOWLIST=
